#!/bin/sh
# Refuse to commit development material on the shipped branch.
#
# What this hook is, and is not: a convenience that catches the mistake early on
# the machine making it. It is NOT the guarantee. A hook does not run on a
# fast-forward merge (no commit is created), is skipped by `--no-verify`, goes
# stale as a copy, and is absent in a fresh clone until someone installs it. The
# guarantee is `tests/branch-model.test.sh` in the gate and the same suite in
# `.github/workflows/ci.yml`, where it cannot be skipped. See INSTALL below.
#
# The check keys on the *branch name* `master`, never on "the default branch":
# since R13 the default branch is `dev`, the integration branch that carries all
# of this material on purpose, and a guard keyed on the default branch would
# refuse every normal commit.
#
# INSTALL, once per clone — copies, not core.hooksPath, and both hooks:
#
#   for h in pre-commit pre-merge-commit guard.sh; do
#       cp .githooks/$h .git/hooks/$h && chmod +x .git/hooks/$h
#   done
#
# `git config core.hooksPath .githooks` looks tidier but goes inert exactly
# where it matters: `.githooks/` is denylisted, so checking out `master` removes
# the directory and git then finds no hook to run. `.git/` belongs to no branch,
# so copies there survive the switch. Re-copy them when these files change.
#
# Bypass deliberately:  OMAFAN_ALLOW_DEV_PATHS=1 git commit ...
set -u

[ "${OMAFAN_ALLOW_DEV_PATHS:-0}" = "1" ] && exit 0

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo "")
# Detached HEAD (rebase, cherry-pick, the release sync's worktree) and every
# feature branch are someone else's problem; only the shipped branch is guarded,
# and it is checked *before* guard.sh and the lists are required so that a
# branch without them — an old one, or one predating this hook — is never
# blocked.
#
# The shipped branch's name is the one fact this hook needs before it can read
# the lists, so it also appears here as a literal. tests/lib/shipped-paths.sh is
# its home and tests/branch-model.test.sh asserts every copy agrees with it.
[ "$branch" = "master" ] || exit 0

guard="$(dirname "$0")/guard.sh"
if [ ! -r "$guard" ]; then
    printf 'pre-commit: cannot read %s — refusing to guess on %s.\n' "$guard" "$branch" >&2
    printf '  re-install the hooks, or: OMAFAN_ALLOW_DEV_PATHS=1 git commit ...\n' >&2
    exit 1
fi
# shellcheck source=.githooks/guard.sh
. "$guard"

omafan_guard pre-commit staged
