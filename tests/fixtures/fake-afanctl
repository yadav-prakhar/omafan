#!/usr/bin/env bash
# tests/fixtures/fake-afanctl - a hardware-free stand-in for the afanctl CLI.
#
# omafan's suites never touch the live fan daemon, so this script emulates the
# slice of afanctl's surface that omafan uses: `status [--json]`, `hold <rpm>`,
# `observe`/`curve`, and `--version`. It is deliberately loud about its safety
# boundary: it refuses to run without a caller-provided runtime directory and
# refuses to touch /run/afanctl, /sys, /etc or /usr.
#
# Environment switches
#   AFANCTL_RUNTIME_DIR  runtime directory (--runtime-dir overrides it)
#   FAKE_AFANCTL_MODE    observe (default) | hold | monitor-only | absent | error
#   FAKE_AFANCTL_SCHEMA  v1 (default) | v1-supported | v2-newer | v2-compat |
#                        v0-older | v0-compat | missing | malformed
#   AFANCTL_FAKE_FAIL=1  every write (hold/observe/curve) exits 1
#
# FAKE_AFANCTL_MODE selects the daemon state `status` reports:
#   observe       running, mode observe       (fixture status-observe.json)
#   hold          running, mode hold          (fixture status-hold.json)
#   monitor-only  running, monitor_only latch (status-hold.json, latch set)
#   absent        no daemon (running:false)   (status-observe.json, state gone)
#   error         every verb exits 1 with a runtime failure
#
# FAKE_AFANCTL_SCHEMA selects the schema `status` reports, independently of the
# daemon state (omafan#4's negotiation matrix):
#   v1            afanctl.status.v1, no schema_supported  (today's daemon)
#   v1-supported  v1 plus schema_supported [v1, v2]       (older-but-supported)
#   v2-newer      v2 (v1 fields plus unknown ones), advertises v2 only
#   v2-compat     v2 (restructured fans[]), advertises [v1, v2]; a
#                 `--schema afanctl.status.v1` request returns the v1 fixture
#   v0-older      afanctl.status.v0, advertises v0 only
#   v0-compat     afanctl.status.v0 default that also advertises v1; a
#                 `--schema afanctl.status.v1` request returns the v1 fixture
#   missing       the v1 document with .schema deleted
#   malformed     .schema = "afanctl.status" (no version)
#
# Writes append their effective argv to "$runtime_dir/argv.log" and write an
# afanctl.cmd.v1 document to "$runtime_dir/cmd.json" (atomic tmp+rename), which
# mirrors the real CLI and lets tests assert exactly what was requested. Reads
# append their argv to "$runtime_dir/status-argv.log" so a negotiated
# `status --schema <id>` re-request is visible.

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

readonly HW_MIN_RPM=1200
readonly HW_MAX_RPM=7200
readonly AFANCTL_VERSION="afanctl 0.1.0"

runtime_dir="${AFANCTL_RUNTIME_DIR:-}"
mode="${FAKE_AFANCTL_MODE:-observe}"
schema_mode="${FAKE_AFANCTL_SCHEMA:-v1}"

usage() {
    cat >&2 <<'EOF'
afanctl 0.1.0 - applesmc fan supervisor (pre-T2 Intel Mac) [fake fixture]

USAGE:  afanctl <verb> [options] [--runtime-dir DIR]

VERBS:
  status [--json]        report the simulated daemon/fan snapshot
  hold <rpm>             request a held rpm (1200..7200; below min is rejected)
  observe | curve        request firmware auto / the software curve
  --version, -h          version / this help

GLOBALS:
  --runtime-dir <dir>    fixture runtime dir (or AFANCTL_RUNTIME_DIR)
  --config <path>        accepted and ignored (the fixture has no config)
  --sysfs-root <dir>     accepted and ignored (the fixture never touches sysfs)

EXIT CODES: 0 success   1 runtime failure   2 usage/CLI error
EOF
}

usage_error() {
    printf 'afanctl: %s\n' "$1" >&2
    usage
    exit 2
}

runtime_error() {
    printf '%s\n' "$1" >&2
    exit 1
}

validate_mode() {
    case "$mode" in
        observe | hold | monitor-only | absent | error) ;;
        *) usage_error "unknown FAKE_AFANCTL_MODE: $mode" ;;
    esac
}

validate_schema() {
    case "$schema_mode" in
        v1 | v1-supported | v2-newer | v2-compat | v0-older | v0-compat | missing | malformed) ;;
        *) usage_error "unknown FAKE_AFANCTL_SCHEMA: $schema_mode" ;;
    esac
}

# Refuse to run without an explicit runtime dir, and never operate on the live
# daemon's directory or any system path. Tests must pass a tempdir.
require_runtime_dir() {
    if [ -z "$runtime_dir" ]; then
        usage_error "no runtime dir given (pass --runtime-dir DIR or set AFANCTL_RUNTIME_DIR; refusing to run)"
    fi
    # Strip a trailing slash so "/run/afanctl/" is caught too.
    case "${runtime_dir%/}" in
        /run/afanctl | /run/afanctl/*)
            usage_error "refusing to touch the live daemon runtime dir ($runtime_dir)" ;;
        /sys | /sys/* | /etc | /etc/* | /usr | /usr/* | /run | /run/* | / | "")
            usage_error "refusing a system path as runtime dir ($runtime_dir)" ;;
    esac
}

# Print the base afanctl.status.v1 snapshot for the selected FAKE_AFANCTL_MODE.
# The monitor-only and absent documents are derived with jq so the fixture set
# stays small and every derived field stays consistent with its base fixture.
# The schema switch (status_json) transforms this base.
base_status_json() {
    case "$mode" in
        observe)
            cat -- "$script_dir/status-observe.json" ;;
        hold)
            cat -- "$script_dir/status-hold.json" ;;
        monitor-only)
            jq '.daemon.monitor_only = true
                | .recent_errors = [{"ts":"2026-09-15T03:28:11+05:30",
                    "msg":"write-back verification failed three times; degraded to AUTO + monitor-only (fix: systemctl restart afanctl)"}]' \
                -- "$script_dir/status-hold.json" || runtime_error "afanctl: failed to render monitor-only status fixture" ;;
        absent)
            jq '.daemon.running = false
                | .daemon.watchdog_armed = false
                | .daemon.uptime_s = 0
                | .fan.target_rpm = null
                | .fan.manual = false
                | .recent_errors = []' \
                -- "$script_dir/status-observe.json" || runtime_error "afanctl: failed to render absent status fixture" ;;
    esac
}

# Apply FAKE_AFANCTL_SCHEMA to the base document. $1 is a requested schema id
# (empty = the mode's default); a request the mode does not advertise is a usage
# error, matching the real CLI's exit 2. v2-newer is additive (v1 fields plus
# unknown ones); v2-compat is the restructured v2 shape and answers a v1 request
# with the v1 fixture, which is what the negotiated re-request exercises.
status_json() {
    local requested="${1:-}" base
    base="$(base_status_json)"
    case "$schema_mode" in
        v1)
            if [ -n "$requested" ] && [ "$requested" != "afanctl.status.v1" ]; then
                usage_error "schema $requested is not advertised by FAKE_AFANCTL_SCHEMA=v1"
            fi
            printf '%s\n' "$base" ;;
        v1-supported)
            if [ -n "$requested" ] && [ "$requested" != "afanctl.status.v1" ]; then
                usage_error "schema $requested is not advertised by FAKE_AFANCTL_SCHEMA=v1-supported"
            fi
            printf '%s\n' "$base" \
                | jq -c '.schema_supported = ["afanctl.status.v1","afanctl.status.v2"]' ;;
        v2-newer)
            if [ -n "$requested" ] && [ "$requested" != "afanctl.status.v2" ]; then
                usage_error "schema $requested is not advertised by FAKE_AFANCTL_SCHEMA=v2-newer"
            fi
            printf '%s\n' "$base" | jq -c '
                .schema = "afanctl.status.v2"
                | .schema_supported = ["afanctl.status.v2"]
                | .backend = {kind: "applesmc", abi: "modern", kernel_min: "7.3"}
                | .safety = {l1_reassert: true, l2_death_path: true, hardware_watchdog: null}
                | .future = {unknown: true}' ;;
        v2-compat)
            case "$requested" in
                "" | "afanctl.status.v2")
                    printf '%s\n' "$base" | jq -c '
                        . as $v1
                        | {schema: "afanctl.status.v2",
                           schema_supported: ["afanctl.status.v1","afanctl.status.v2"],
                           backend: {kind: "applesmc", abi: "legacy", kernel_min: "7.2"},
                           daemon: $v1.daemon,
                           safety: {l1_reassert: true, l2_death_path: true},
                           fans: [{id: "applesmc:fan1", label: "Exhaust",
                                   control: {kind: "rpm_target", min: $v1.fan.min_rpm, max: $v1.fan.max_rpm},
                                   readable_rpm: true, verify: "tolerance:50",
                                   rpm: $v1.fan.rpm, target: $v1.fan.target_rpm, owned: $v1.fan.manual}],
                           sensors: $v1.sensors, effective: $v1.effective,
                           recent_errors: $v1.recent_errors}' ;;
                "afanctl.status.v1")
                    printf '%s\n' "$base" ;;
                *)
                    usage_error "schema $requested is not advertised by FAKE_AFANCTL_SCHEMA=v2-compat" ;;
            esac ;;
        v0-older)
            if [ -n "$requested" ] && [ "$requested" != "afanctl.status.v0" ]; then
                usage_error "schema $requested is not advertised by FAKE_AFANCTL_SCHEMA=v0-older"
            fi
            printf '%s\n' "$base" \
                | jq -c '.schema = "afanctl.status.v0" | .schema_supported = ["afanctl.status.v0"]' ;;
        v0-compat)
            case "$requested" in
                "" | "afanctl.status.v0")
                    printf '%s\n' "$base" | jq -c '
                        .schema = "afanctl.status.v0"
                        | .schema_supported = ["afanctl.status.v0","afanctl.status.v1"]' ;;
                "afanctl.status.v1")
                    printf '%s\n' "$base" ;;
                *)
                    usage_error "schema $requested is not advertised by FAKE_AFANCTL_SCHEMA=v0-compat" ;;
            esac ;;
        missing)
            if [ -n "$requested" ]; then
                usage_error "schema $requested is not advertised by FAKE_AFANCTL_SCHEMA=missing"
            fi
            printf '%s\n' "$base" | jq -c 'del(.schema)' ;;
        malformed)
            if [ -n "$requested" ]; then
                usage_error "schema $requested is not advertised by FAKE_AFANCTL_SCHEMA=malformed"
            fi
            printf '%s\n' "$base" | jq -c '.schema = "afanctl.status"' ;;
    esac
}

# Human status summary mirroring the real CLI's one-fact-per-line shape.
status_human() {
    status_json | jq -r '
        "daemon: " + (if .daemon.running then "running" else "not running" end),
        "mode: " + (.daemon.mode // "observe") + (if .daemon.monitor_only then " (monitor-only)" else "" end),
        (if .daemon.auto_restore_pending then "auto_restore_pending: true (AUTO restore pending)" else empty end),
        (.sensors[] | "sensor " + .label + ": " + (if .temp_c == null then "n/a" else ((.temp_c | tostring) + " C") end)),
        "t_eff: " + (if .effective.temp_c == null then "n/a" else ((.effective.temp_c | tostring) + " C") end),
        "fan: " + (.fan.rpm | tostring) + " rpm (" + (.fan.min_rpm | tostring) + ".." + (.fan.max_rpm | tostring) + ", manual=" + (.fan.manual | tostring) + ")",
        "target: " + (if .fan.target_rpm == null then "n/a" else ((.fan.target_rpm | tostring) + " rpm") end),
        "config: high=" + (.config.high_c | tostring) + " max=" + (.config.max_c | tostring) + " min_rpm=" + (.config.min_rpm | tostring) + " max_rpm=" + (.config.max_rpm | tostring) + " interval_s=" + (.config.interval_s | tostring) + " source=" + .config.source,
        "recent_errors: " + (if (.recent_errors | length) == 0 then "none" else (.recent_errors | map(.msg) | join("; ")) end)'
}

cmd_status() {
    # Log the read argv so a negotiated `status --schema <id>` re-request is
    # visible to tests (writes already log to argv.log).
    printf '%s\n' "$*" >>"$runtime_dir/status-argv.log"
    local json=0 requested="" arg
    while [ "$#" -gt 0 ]; do
        arg="$1"
        case "$arg" in
            --json)
                json=1
                shift ;;
            --schema)
                [ "$#" -ge 2 ] || usage_error "missing value for --schema"
                requested="$2"
                shift 2 ;;
            --schema=*)
                requested="${arg#*=}"
                shift ;;
            *)
                usage_error "unknown flag for status: $arg" ;;
        esac
    done
    if [ "$mode" = "error" ]; then
        runtime_error "afanctl: sysfs read failed: /sys/devices/platform/applesmc.768/fan1_input: No such file or directory"
    fi
    if [ "$json" -eq 1 ]; then
        status_json "$requested"
    else
        status_human
    fi
}

# Append the effective write argv so tests can assert what omafan asked for.
log_argv() {
    printf '%s\n' "$*" >>"$runtime_dir/argv.log"
}

# Write an afanctl.cmd.v1 document (atomic tmp+rename), exactly like the CLI.
write_cmd() {
    local wmode="$1" rpm="${2:-}" body tmp
    if [ "${AFANCTL_FAKE_FAIL:-0}" = "1" ]; then
        runtime_error "afanctl: $wmode write failed: $runtime_dir: Permission denied (simulated AFANCTL_FAKE_FAIL)"
    fi
    if [ "$mode" = "error" ]; then
        runtime_error "afanctl: command channel unavailable: $runtime_dir (simulated FAKE_AFANCTL_MODE=error)"
    fi
    mkdir -p -- "$runtime_dir"
    if [ -n "$rpm" ]; then
        body="$(jq -cn --arg m "$wmode" --argjson r "$rpm" '{schema:"afanctl.cmd.v1",mode:$m,rpm:$r}')"
    else
        body="$(jq -cn --arg m "$wmode" '{schema:"afanctl.cmd.v1",mode:$m}')"
    fi
    tmp="$(mktemp -- "$runtime_dir/.cmd.json.XXXXXX")"
    printf '%s' "$body" >"$tmp"
    mv -f -- "$tmp" "$runtime_dir/cmd.json"
}

cmd_hold() {
    if [ "$#" -ne 1 ]; then
        usage_error "hold needs exactly one rpm argument"
    fi
    local rpm_arg="$1" rpm target
    case "$rpm_arg" in
        '' | *[!0-9]*)
            usage_error "invalid rpm: $rpm_arg" ;;
    esac
    # 10# forces base 10, so a leading zero is never read as octal.
    rpm=$((10#$rpm_arg))
    if [ "$rpm" -lt "$HW_MIN_RPM" ]; then
        runtime_error "invalid hold rpm: $rpm is below fan1_min $HW_MIN_RPM (fix: hold a value in $HW_MIN_RPM..=$HW_MAX_RPM rpm)"
    fi
    target="$rpm"
    if [ "$rpm" -gt "$HW_MAX_RPM" ]; then
        target="$HW_MAX_RPM"
        printf 'afanctl: hold rpm %s clamped to fan1_max %s\n' "$rpm" "$HW_MAX_RPM" >&2
    fi
    write_cmd hold "$target"
    log_argv "hold $target"
}

# observe/curve write their command with no rpm.
cmd_mode_write() {
    local requested="$1"
    write_cmd "$requested"
    log_argv "$requested"
}

# Parse order-insensitively: globals may appear before or after the verb,
# matching how omafan-ctl itself accepts its flags. Non-flag tokens (the verb,
# its arguments, and verb-level flags such as --json) are collected in order.
positional=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        --runtime-dir)
            [ "$#" -ge 2 ] || usage_error "missing value for --runtime-dir"
            runtime_dir="$2"
            shift 2 ;;
        --runtime-dir=*)
            runtime_dir="${1#*=}"
            shift ;;
        --config)
            [ "$#" -ge 2 ] || usage_error "missing value for --config"
            shift 2 ;;
        --config=*)
            shift ;;
        --sysfs-root)
            [ "$#" -ge 2 ] || usage_error "missing value for --sysfs-root"
            shift 2 ;;
        --sysfs-root=*)
            shift ;;
        --version)
            printf '%s\n' "$AFANCTL_VERSION"
            exit 0 ;;
        -h | --help)
            usage
            exit 0 ;;
        --json)
            positional+=("--json")
            shift ;;
        --schema)
            [ "$#" -ge 2 ] || usage_error "missing value for --schema"
            positional+=("--schema" "$2")
            shift 2 ;;
        --schema=*)
            positional+=("--schema" "${1#*=}")
            shift ;;
        --* | -*)
            usage_error "unknown flag \`$1'" ;;
        *)
            positional+=("$1")
            shift ;;
    esac
done

if [ "${#positional[@]}" -eq 0 ]; then
    usage_error "no verb given"
fi
set -- "${positional[@]}"
verb="$1"
shift

validate_mode
validate_schema

case "$verb" in
    status)
        require_runtime_dir
        cmd_status "$@" ;;
    hold)
        require_runtime_dir
        cmd_hold "$@" ;;
    observe | curve)
        require_runtime_dir
        cmd_mode_write "$verb" ;;
    *)
        usage_error "unknown verb \`$verb'" ;;
esac
