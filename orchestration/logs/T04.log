+# Shared human fix lines (English, one line, the same words everywhere).
+readonly FIX_INSTALL_AC="Fix: install afanctl (see its packaging/ directory)"
+readonly FIX_RESTART_AC="Fix: systemctl restart afanctl"
+readonly FIX_STATUS="Fix: run: omafan-ctl status --json"
+
+msg_afanctl_missing() {
+    printf "afanctl binary '%s' is missing or not executable. %s" \
+        "$afanctl_bin" "$FIX_INSTALL_AC"
+}
+
+msg_limits_unavailable() {
+    printf 'hardware limits unknown (afanctl status did not work; see stderr). %s' \
+        "Fix: run afanctl status --json by hand and check the daemon"
+}
+
 add_warning() {
