+        if [ "$hold_rpm" != "null" ] && [ -n "$hw_min" ]; then
+            for pid in auto off low med high full; do
+                pr="$(preset_rpm "$pid")" || pr=""
+                if [ "$hold_rpm" = "$pr" ]; then
+                    hold_preset="$pid"
+                    break
+                fi
+            done
+        fi
+        if [ "$hold_preset" = "custom" ]; then
+            printf 'off\n'
+        else
+            printf '%s\n' "$hold_preset"
+        fi
+        return 0
+    fi
+    printf 'auto\n'
