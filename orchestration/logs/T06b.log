+# check_helper - install only (T06b D2). The helper path is embedded in a Lua
+# string Hyprland hands to a shell; an unusable helper is a silent failure at
+# key-press time, so install refuses loudly and writes nothing.
+check_helper() {
+    if ! [ -f "$ctl" ] || ! [ -x "$ctl" ]; then
+        die 1 "helper $ctl is not an executable file, but the emitted chords \
+would run it on every key press - set OMAFAN_CTL to the real bin/omafan-ctl \
+(or install the plugin) and run install again. Nothing was written."
+    fi
+    case "$ctl" in
+        *[[:space:]\"\'\\]*)
+            die 1 "helper path contains whitespace, a quote or a backslash \
+($ctl) - the path goes inside a Lua string that Hyprland hands to a shell and \
+cannot be quoted safely there - move the plugin to a space-free path (or set \
+OMAFAN_CTL) and run install again. Nothing was written." ;;
+    esac
+}
+
