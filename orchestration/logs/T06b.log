+# on_disk_helper <file> -> the executable the installed block's preset/cycle
+# chords call first; empty when the block binds none of them. T06b D3: this
+# is how `status` detects that the plugin (or OMAFAN_CTL) has moved since the
+# block was written.
+on_disk_helper() {
+    on_disk_block "$1" |
+        grep '^o\.bind(' |
+        sed -n 's/^o\.bind("[^"]*", "[^"]*", "\(.*\)")$/\1/p' |
+        sed -n 's/^\([^[:space:]"]*\) \(preset\|cycle\) .*/\1/p' |
+        head -n 1
+}
+
